# ============================================
# CONFIGURARE EMAIL (Gmail)
# ============================================
# Pasul 1: Activează "Less secure app access" în contul Google
#        sau generează un "App Password" din setările de securitate
# Pasul 2: Completează datele de mai jos

EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=parola_sau_app_password

# ============================================
# CONFIGURARE SUPABASE (Database în cloud)
# ============================================
# Pasul 1: Creează un cont pe https://supabase.com
# Pasul 2: Creează un nou proiect
# Pasul 3: Din Project Settings > API, copiază:
#          - Project URL
#          - service_role key (pentru backend - NU publicați aceasta!)

SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...service_role_key

# ============================================
# CONFIGURARE SERVER
# ============================================
PORT=5000

# ============================================
# NOTĂ IMPORTANTĂ DE SECURITATE
# ============================================
# NICIODATĂ să nu comiți fișierul .env în git!
# Asigură-te că .gitignore conține:
# .env
# backend/.env
